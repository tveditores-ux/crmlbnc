# ─── Copia este archivo como .env para trabajar en tu computadora ───
# En Railway estas mismas variables van en: servicio → Variables.

# Base de datos (en Railway usa la referencia: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://usuario:clave@localhost:5432/comunica

# Identidad
CHURCH_NAME=Las Buenas Nuevas de Cabudare
TIMEZONE=America/Caracas
DEFAULT_COUNTRY_CODE=58
# PUBLIC_URL se calcula sola en Railway. Ponla solo si usas un dominio propio.
# PUBLIC_URL=https://comunicacion.tuiglesia.org

# Acceso al panel
ADMIN_PASSWORD=cambia-esta-clave-larga
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Envíos: deja DRY_RUN=true hasta terminar las pruebas
DRY_RUN=true
SEND_WINDOW_START=8
SEND_WINDOW_END=20
SCHEDULER_INTERVAL_MINUTES=10

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=recordatorio_evento
WHATSAPP_TEMPLATE_LANG=es
WHATSAPP_API_VERSION=v23.0

# Correo: resend (recomendado en Railway) | smtp | none
EMAIL_PROVIDER=none
EMAIL_FROM=Iglesia <avisos@tudominio.org>
RESEND_API_KEY=
# Solo si EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Asistente de WhatsApp (apagado por defecto). Solo atiende temas de la congregación y grupos de cuidado.
AGENT_ENABLED=false
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
AGENT_MAX_REPLIES_PER_DAY=12
